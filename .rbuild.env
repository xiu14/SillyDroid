# rbuild 项目配置（见 /root/workspace/android-remote-build/README.md「项目配置」）
# 完整构建 scripts/build-stdroid-full.sh 依赖 git（stage 4 用 git ls-files 导出工程、构建计划读标签），
# 阶段产物写在 artifacts/ 下，需要留在构建机上复用，最终 APK 拉回本机。
RBUILD_SYNC_GIT=1
RBUILD_EXCLUDES=(/artifacts/)
RBUILD_PULL=('/artifacts/releases/android-apk/**')
# 与 CI（sillydroid-upstream-apk.yml）安装的系统包一致：stage 1/2 解 .deb 需要 ar / readelf；
# libatomic1 是 stage 3 下载的官方 Node.js 二进制的运行依赖（ubuntu-latest 自带，精简系统没有）。
RBUILD_APT_PACKAGES=(unzip zip binutils xz-utils libatomic1)
